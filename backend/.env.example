# LendLoop Backend Environment Variables
# Copy this file to .env and fill in your actual values.

# App
SECRET_KEY=your-super-secret-jwt-key-min-32-chars-here
APP_ENV=development
DEBUG=True

# Database (PostgreSQL with asyncpg)
# Example local: postgresql+asyncpg://user:password@localhost:5432/lendloop
# Example Neon: postgresql+asyncpg://user:password@host.neon.tech/lendloop?ssl=require
DATABASE_URL=postgresql+asyncpg://lendloop_user:your_password@localhost:5432/lendloop
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Firebase Admin SDK
# Path to the downloaded service account JSON file
FIREBASE_CREDENTIALS_PATH=./lendloop-f8a88-firebase-adminsdk-fbsvc-119f2d4a55.json
FIREBASE_PROJECT_ID=lendloop-f8a88
FIREBASE_API_KEY=your-firebase-web-api-key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=lendloop_items

# Domain Restriction
ALLOWED_EMAIL_DOMAINS=vit.ac.in,vitstudent.ac.in

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# QR Verification
QR_TOKEN_SECRET=another-strong-random-secret-for-qr-signing
QR_TOKEN_EXPIRE_MINUTES=30

# FCM (Firebase Cloud Messaging)
FCM_SERVER_KEY=your-fcm-server-key

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://10.0.2.2:8000
